# ─────────────────────────────────────────────────────────────
# WEFIT Ladies — Environment Variables
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` to version control.
# ─────────────────────────────────────────────────────────────

# Public site URL (used to build QR / registration links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used by server actions for privileged writes (activity logs, admin ops).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
